@model CustomerSupportAI.ViewModels.UserCreateViewModel
@{
    var isCustomers = Model.Portal == "Customers";
    ViewData["Title"] = isCustomers ? "Thêm khách hàng" : "Thêm tài khoản";
}

<a class="back-link" asp-controller="@Model.Portal" asp-action="@(isCustomers ? "Index" : "Users")">&larr; @(isCustomers ? "Danh sách khách hàng" : "Tài khoản và quyền")</a>
<section class="form-page">
    <header class="page-heading compact-heading">
<div>
<span class="eyebrow">@(isCustomers ? "QUẢN LÝ KHÁCH HÀNG" : "QUẢN TRỊ HỆ THỐNG")</span>
<h1>@(isCustomers ? "Thêm khách hàng" : "Thêm tài khoản")</h1>
<p>Tạo tài khoản với mật khẩu tạm thời và gửi cho người dùng qua kênh bảo mật.</p>
</div>
</header>
    <form asp-controller="@Model.Portal" asp-action="Create" method="post" class="surface form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary">
</div>
        <label asp-for="DisplayName">Họ và tên</label>
        <input asp-for="DisplayName" autocomplete="off" maxlength="100" />
        <span asp-validation-for="DisplayName" class="field-error">
</span>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" autocomplete="off" />
        <span asp-validation-for="Email" class="field-error">
</span>
        @if (Model.AllowedRoles.Count > 1)
        {
            <label asp-for="Role">Vai trò</label>
            <select asp-for="Role">
                @foreach (var roleName in Model.AllowedRoles)
                {
                    <option value="@roleName">@DisplayText.Role(roleName)</option>
                }
            </select>
            <span asp-validation-for="Role" class="field-error">
</span>
        }
        <label asp-for="Password">Mật khẩu tạm thời</label>
        <input asp-for="Password" autocomplete="new-password" placeholder="Ít nhất 10 ký tự" />
        <span asp-validation-for="Password" class="field-error">
</span>
        <div class="form-footer">
<span>Hành động này được ghi vào nhật ký hoạt động.</span>
<div>
<a class="button button-secondary" asp-controller="@Model.Portal" asp-action="@(isCustomers ? "Index" : "Users")">Hủy</a>
<button class="button button-primary" type="submit">Tạo tài khoản</button>
</div>
</div>
    </form>
</section>
