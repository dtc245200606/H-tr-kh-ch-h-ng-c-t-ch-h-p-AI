@model CustomerSupportAI.ViewModels.AdminUsersViewModel
@{
    ViewData["Title"] = "Tài khoản và quyền";
}

<header class="page-heading">
<div>
<span class="eyebrow">QUẢN TRỊ HỆ THỐNG</span>
<h1>Tài khoản và quyền</h1>
<p>Xem, thêm, sửa, khóa và xóa tài khoản nhân viên, khách hàng.</p>
</div>
<div class="admin-toolbar">
<a class="button button-secondary" asp-action="AuditLog">Nhật ký hoạt động</a>
<a class="button button-primary" asp-action="Create"><span aria-hidden="true">＋</span> Thêm tài khoản</a>
</div>
</header>
<div class="admin-users-layout">
    <section class="data-section user-directory">
        <div class="section-heading">
<div>
<h2>Tài khoản</h2>
<p>Tìm theo tên hoặc email, lọc theo vai trò.</p>
</div>
<span class="result-count">@Model.Users.Count tài khoản</span>
</div>
        <form class="filter-bar" method="get" asp-action="Users">
            <label class="search-field">
<span aria-hidden="true">⌕</span>
<input name="search" value="@Model.Search" placeholder="Tìm tên hoặc email" aria-label="Tìm tài khoản" />
</label>
            <select name="role" aria-label="Lọc theo vai trò">
                <option value="">Tất cả vai trò</option>
                @foreach (var roleName in UserRoles.All)
                {
                    <option value="@roleName" selected="@(Model.Role == roleName ? "selected" : null)">@DisplayText.Role(roleName)</option>
                }
            </select>
            <button class="button button-secondary" type="submit">Lọc</button>
        </form>
        <div class="table-scroll">
<table class="data-table">
<thead>
<tr>
<th>Người dùng</th>
<th>Vai trò</th>
<th>Trạng thái</th>
<th>Yêu cầu</th>
<th>Ngày tham gia</th>
<th>
</th>
</tr>
</thead>
<tbody>
        @foreach (var item in Model.Users)
        {
            <tr>
<td>
<div class="person-cell">
<span class="avatar avatar-light">@item.User.DisplayName.Substring(0, 1).ToUpperInvariant()</span>
<span>
<strong>@item.User.DisplayName</strong>
<small>@item.User.Email</small>
</span>
</div>
</td>
<td>
<span class="role-tag role-@item.User.Role.ToLowerInvariant()">@DisplayText.Role(item.User.Role)</span>
</td>
<td>
<span class="state-tag @(item.User.IsActive ? "state-active" : "state-locked")">@(item.User.IsActive ? "Hoạt động" : "Đã khóa")</span>
</td>
<td>@item.TicketCount</td>
<td>@item.User.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
<td>
<a class="text-link" asp-action="Details" asp-route-id="@item.User.Id">Xem</a> ·
<a class="text-link" asp-action="Edit" asp-route-id="@item.User.Id">Sửa</a>
</td>
</tr>
        }
        </tbody>
</table>
</div>
        @if (Model.Users.Count == 0)
        {
            <p class="table-note">Không có tài khoản phù hợp với bộ lọc.</p>
        }
    </section>
    <aside class="staff-form-panel">
        <span class="eyebrow">THÊM NHANH</span>
<h2>Thêm nhân viên hỗ trợ</h2>
<p>Nhân viên mới có thể xử lý yêu cầu và quản lý khách hàng. Dùng "Thêm tài khoản" để tạo quản trị viên hoặc khách hàng.</p>
        <form asp-action="CreateStaff" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation-summary">
</div>
            <label asp-for="NewStaff.DisplayName">Họ và tên</label>
<input asp-for="NewStaff.DisplayName" autocomplete="name" placeholder="Nguyễn Minh Anh" />
<span asp-validation-for="NewStaff.DisplayName" class="field-error">
</span>
            <label asp-for="NewStaff.Email">Email công việc</label>
<input asp-for="NewStaff.Email" autocomplete="email" placeholder="nhanvien@congty.vn" />
<span asp-validation-for="NewStaff.Email" class="field-error">
</span>
            <label asp-for="NewStaff.TemporaryPassword">Mật khẩu tạm thời</label>
<input asp-for="NewStaff.TemporaryPassword" autocomplete="new-password" placeholder="Ít nhất 10 ký tự" />
<span asp-validation-for="NewStaff.TemporaryPassword" class="field-error">
</span>
            <button class="button button-primary button-wide" type="submit">Tạo tài khoản nhân viên <span aria-hidden="true">&rarr;</span>
</button>
            <small class="form-hint">Hãy gửi mật khẩu tạm thời qua kênh bảo mật. Có thể đặt lại mật khẩu trong trang Sửa tài khoản.</small>
        </form>
    </aside>
</div>
