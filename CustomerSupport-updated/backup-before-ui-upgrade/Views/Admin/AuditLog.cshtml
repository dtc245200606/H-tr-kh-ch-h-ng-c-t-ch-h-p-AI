@model IReadOnlyList<CustomerSupportAI.Models.AuditLog>
@{
    ViewData["Title"] = "Nhật ký hoạt động";
    string ActionText(string action) => action switch
    {
        "user.create" => "Tạo tài khoản",
        "user.update" => "Cập nhật tài khoản",
        "user.lock" => "Khóa tài khoản",
        "user.unlock" => "Mở khóa tài khoản",
        "user.delete" => "Xóa tài khoản",
        _ => action
    };
}

<a class="back-link" asp-action="Users">&larr; Tài khoản và quyền</a>
<header class="page-heading">
<div>
<span class="eyebrow">QUẢN TRỊ HỆ THỐNG</span>
<h1>Nhật ký hoạt động</h1>
<p>200 thao tác quản lý tài khoản gần nhất của quản trị viên và nhân viên.</p>
</div>
</header>
<section class="data-section">
    @if (Model.Count == 0)
    {
        <div class="empty-state">
<span class="empty-mark">—</span>
<h3>Chưa có hoạt động nào</h3>
<p>Các thao tác tạo, sửa, khóa và xóa tài khoản sẽ được ghi lại tại đây.</p>
</div>
    }
    else
    {
        <div class="table-scroll">
<table class="data-table">
<thead>
<tr>
<th>Thời gian</th>
<th>Người thực hiện</th>
<th>Thao tác</th>
<th>Đối tượng</th>
<th>Chi tiết</th>
</tr>
</thead>
<tbody>
        @foreach (var entry in Model)
        {
            <tr>
<td>@entry.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
<td>@entry.ActorName</td>
<td>@ActionText(entry.Action)</td>
<td>@entry.Target</td>
<td>@entry.Detail</td>
</tr>
        }
        </tbody>
</table>
</div>
    }
</section>
