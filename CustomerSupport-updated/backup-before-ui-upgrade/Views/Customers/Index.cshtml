@model CustomerSupportAI.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<header class="page-heading">
<div>
<span class="eyebrow">NHÂN VIÊN HỖ TRỢ</span>
<h1>Quản lý khách hàng</h1>
<p>Xem hồ sơ, sửa thông tin, khóa hoặc xóa tài khoản khách hàng.</p>
</div>
<a class="button button-primary" asp-action="Create"><span aria-hidden="true">＋</span> Thêm khách hàng</a>
</header>

<section class="data-section">
    <div class="section-heading">
<div>
<h2>Danh sách khách hàng</h2>
<p>Tìm theo tên hoặc email. Tổng cộng @Model.TotalCustomers khách hàng.</p>
</div>
<span class="result-count">@Model.Users.Count hiển thị</span>
</div>
    <form class="filter-bar" method="get" asp-action="Index">
        <label class="search-field">
<span aria-hidden="true">⌕</span>
<input name="search" value="@Model.Search" placeholder="Tìm tên hoặc email" aria-label="Tìm khách hàng" />
</label>
        <select name="status" aria-label="Lọc theo trạng thái">
            <option value="">Tất cả trạng thái</option>
            <option value="active" selected="@(Model.Status == "active" ? "selected" : null)">Hoạt động</option>
            <option value="locked" selected="@(Model.Status == "locked" ? "selected" : null)">Đã khóa</option>
        </select>
        <button class="button button-secondary" type="submit">Lọc</button>
    </form>
    @if (Model.Users.Count == 0)
    {
        <div class="empty-state">
<span class="empty-mark">—</span>
<h3>Không có khách hàng phù hợp</h3>
<p>Hãy thử thay đổi từ khóa hoặc bộ lọc.</p>
</div>
    }
    else
    {
        <div class="table-scroll">
<table class="data-table">
<thead>
<tr>
<th>Khách hàng</th>
<th>Trạng thái</th>
<th>Yêu cầu</th>
<th>Ngày tham gia</th>
<th>
</th>
</tr>
</thead>
<tbody>
        @foreach (var item in Model.Users)
        {
            <tr>
<td>
<div class="person-cell">
<span class="avatar avatar-light">@item.User.DisplayName.Substring(0, 1).ToUpperInvariant()</span>
<span>
<strong>@item.User.DisplayName</strong>
<small>@item.User.Email</small>
</span>
</div>
</td>
<td>
<span class="state-tag @(item.User.IsActive ? "state-active" : "state-locked")">@(item.User.IsActive ? "Hoạt động" : "Đã khóa")</span>
</td>
<td>@item.TicketCount</td>
<td>@item.User.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
<td>
<a class="text-link" asp-action="Details" asp-route-id="@item.User.Id">Xem</a> ·
<a class="text-link" asp-action="Edit" asp-route-id="@item.User.Id">Sửa</a>
</td>
</tr>
        }
        </tbody>
</table>
</div>
    }
</section>
